# Walkbox settings. Copy to .env next to docker-compose.yml and change what you need.
# Every line shows the built-in default, so deleting a line changes nothing. Lines starting with # are notes.
# This file can hold your CARTO key: keep it on the NAS and do NOT commit it (it is in .gitignore).

# --- Where things live on the NAS
# Folder that holds the data/ and valhalla/ subfolders. Create both before deploying.
WALKBOX_DIR=/volume1/docker/walkbox

# --- Map look
# Optional free key from carto.com/basemaps/apikey for the cleaner CARTO street map. Blank = OpenStreetMap tiles.
# The key shows in the page, so restrict it to your Walkbox address on the CARTO dashboard. Never commit this file.
CARTO_KEY=

# --- NZ downloads (the Data tab)
# 1 = queue the NZ downloads on the very first start; 0 = start them yourself from the Data tab.
SEED_AUTOSTART=1
# The raw OpenStreetMap file. The walking store is built from it, and Valhalla uses the same file.
OSM_EXTRACT_URL=https://download.geofabrik.de/australia-oceania/new-zealand-latest.osm.pbf
# The OSM file and store are renewed this often (days). 0 = never by themselves. Needs about 1 GB of free memory while it rebuilds.
OSM_REFRESH_DAYS=30
# Size of the map squares used to track which areas the OSM store covers (degrees).
SEED_CELL_DEG=0.5
# Pause between requests when downloading the DOC and council tracks.
SEED_PAUSE_SECONDS=0.3

# --- What counts as a walk
# Shortest named OSM path (joined by name) listed as a walk.
MIN_PATH_KM=0.8
# Shortest council track (grouped by name) listed as a walk.
MIN_TRACK_KM=0.3
# OSM route types included.
ROUTE_TYPES=hiking|foot|walking
# OSM path types used for named paths.
PATH_HIGHWAYS=footway|path|track|pedestrian
# Most path pieces read per live search (only used before the NZ store is built).
MAX_PATH_WAYS=2500

# --- Searching
# Largest map area searched (degrees, about 55 km).
MAX_SPAN_DEG=0.5
# Most routes returned per search.
MAX_RESULTS=150
# How long a finished search of the same area is remembered.
SEARCH_CACHE_SECONDS=21600

# --- Import and photos
# Largest GPX file accepted by Import GPX.
MAX_IMPORT_MB=15
# Most photo lookups per minute (keeps Wikimedia requests polite).
PHOTOS_PER_MINUTE=30

# --- Live OpenStreetMap servers (used where the NZ store has no answer yet, or outside NZ)
# Comma-separated Overpass servers, tried in order.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Ask the next server too if the first has not answered in this time.
OVERPASS_HEDGE_SECONDS=6
# Give up on one request after this many seconds.
OVERPASS_TIMEOUT=30
# Only if you run your own Overpass server. Not needed any more: the NZ store is built from the OSM file.
OVERPASS_LOCAL_URL=

# --- Other services
# Turn-by-turn routing engine (container name and internal port). Blank hides the turn-by-turn buttons.
VALHALLA_URL=http://walkbox-valhalla:8002
# Threads the Valhalla container uses.
VALHALLA_THREADS=2
# Weather service.
WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Elevation service.
ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# Photo service (Wikimedia Commons).
COMMONS_URL=https://commons.wikimedia.org/w/api.php
# DOC walking experiences (change only if the source moves).
DOC_URL=https://services1.arcgis.com/3JjYDyG3oajxU6HO/ArcGIS/rest/services/DOC_Walking_Experiences/FeatureServer/1/query
# National tracks (change only if the source moves).
NZT_URL=https://services2.arcgis.com/b5ADKIcWivL5vNaV/ArcGIS/rest/services/National_Tracks_Dataset_Pilot/FeatureServer/0/query
# How Walkbox introduces itself to the services above.
USER_AGENT="walkbox/1.1 (self-hosted walk library)"
